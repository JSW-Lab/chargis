<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 공공 충전소 데이터 호출(B5). 키가 없으면 호출하지 않는다. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 음성 명령(F5). 설정에서 켤 때만 권한을 묻는다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Pleos Vehicle SDK: 배터리 %·충전 스위치(CAR_ENERGY), 기어(CAR_DRIVE) -->
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 충전 한도 설정과 충전 스위치 끄기(Vehicle SDK EvBattery). 개발 단계는 선언만으로 쓰고, M마켓 배포 때 승인 범위를 맞춘다 -->
    <uses-permission android:name="pleos.car.permission.CONTROL_CAR_ENERGY" />
    <!-- Pleos NaviHelper SDK: 위치·경유지 조회와 경로 예측(NAVI_ROUTE), 경유지 추가·삭제·재탐색(NAVI_ROUTE_SEARCH) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Pleos TextToSpeech·SpeechToText SDK: 안내 음성과 음성 명령 -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:name=".ChargisApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Chargis">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <!-- singleTask: Gleo AI나 런처가 다시 열어도 화면을 하나만 둔다. 둘이 뜨면 여행 컨트롤러도 둘이 되어 안내가 겹친다(2026-11-03 Pleos 에뮬레이터). -->
            <!-- 주행 중에도 쓰는 앱이라는 선언(Distraction Optimization). 없으면 Pleos Connect가 주행 중 앱을 막는다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Gleo AI 연동: assets/schema.json의 함수를 "패키지명.함수명" action으로 받는다(에뮬레이터 v2.1.0 실측). -->
        <receiver
            android:name=".data.sdk.GleoActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.chargis.app.GET_CHARGING_PLAN" />
                <action android:name="com.chargis.app.GET_CHARGING_STATUS" />
                <action android:name="com.chargis.app.ACCEPT_CHARGING_STOP" />
                <action android:name="com.chargis.app.EXPLAIN_RECOMMENDATION" />
                <action android:name="com.chargis.app.DECLINE_STOP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
